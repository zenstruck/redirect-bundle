{
    "name": "zenstruck/redirect-bundle",
    "description": "Store redirects for your site and keeps statistics on redirects and 404 errors",
    "keywords": ["redirect"],
    "homepage": "https://github.com/kbond/ZenstruckRedirectBundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Kevin Bond",
            "email": "kevinbond@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "doctrine/doctrine-bundle": "^2.6|^3.0",
        "doctrine/orm": "^2.6|^3.0",
        "symfony/framework-bundle": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "matthiasnoback/symfony-dependency-injection-test": "^4.3|^5.0|^6.0",
        "symfony/browser-kit": "^6.4|^7.0|^8.0",
        "symfony/form": "^6.4|^7.0|^8.0",
        "symfony/phpunit-bridge": "^7.4",
        "symfony/translation": "^6.4|^7.0|^8.0",
        "symfony/validator": "^6.4|^7.0|^8.0",
        "zenstruck/foundry": "^2.8.1",
        "phpunit/phpunit": "9.6.13|^10.0",
        "zenstruck/browser": "^1.6",
        "symfony/config": "^6.4|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": { "Zenstruck\\RedirectBundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Zenstruck\\RedirectBundle\\Tests\\": "tests/" }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
